<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20" prefHeight="400" prefWidth="300"
      xmlns:fx="http://javafx.com/fxml" fx:controller="controller.LoginController">
    <padding>
        <Insets top="50" bottom="50" left="50" right="50"/>
    </padding>
    
    <Label text="Sistem Manajemen Inventori" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <Label text="Login" style="-fx-font-size: 16px; -fx-text-fill: #333;"/>
    
    <VBox spacing="15" alignment="CENTER">
        <Label text="Username:" />
        <TextField fx:id="usernameField" prefWidth="200"/>
        
        <Label text="Password:" />
        <PasswordField fx:id="passwordField" prefWidth="200"/>
    </VBox>
    
    <HBox spacing="10" alignment="CENTER" GridPane.columnIndex="1">
        <Button text="Login" onAction="#handleLogin" prefWidth="100"/>
        <Button text="Cancel" onAction="#handleCancel" prefWidth="100"/>
    </HBox>
</VBox>